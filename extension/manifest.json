{
  "manifest_version": 3,
  "name": "Challenge Sync — LinkedIn",
  "version": "0.1.2",
  "description": "Privately syncs your own LinkedIn stats to your company's posting challenge. Reads your data only; never your password.",
  "homepage_url": "https://linkedin-challenge-ruby.vercel.app",
  "permissions": ["storage", "alarms", "cookies"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost:3312/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Challenge Sync",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}
