          "orgSlug"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          },
          "memberId": {
            "type": "integer",
            "format": "int64"
          },
          "orgName": {
            "type": "string"
          },
          "orgSlug": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
