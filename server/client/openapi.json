{
  "openapi": "3.1.0",
  "info": {
    "title": "linkedin-challenge-server",
    "description": "",
    "version": "0.1.0"
  },
  "paths": {
    "/api/auth/device/session": {
      "post": {
        "tags": [
          "session"
        ],
        "operationId": "signInDeviceWithSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionDeviceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Sync token issued for this device",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDeviceResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid website session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/join": {
      "post": {
        "tags": [
          "join"
        ],
        "operationId": "joinWithInvite",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Account created and signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinResponse"
                }
              }
            }
          },
          "400": {
            "description": "Password too short",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Invite code not found or already used",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Email already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "login"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in; session cookie set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Wrong email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "logout"
        ],
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Signed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "me"
        ],
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "Current session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/signup": {
      "post": {
        "tags": [
          "signup"
        ],
        "operationId": "signup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Organization created; session cookie set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignupResponse"
                }
              }
            }
          },
          "400": {
            "description": "Password too short",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Email already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/link": {
      "post": {
        "tags": [
          "link"
        ],
        "operationId": "linkIdentity",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "LinkedIn identity bound to this account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing sync token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "That LinkedIn account is linked to someone else",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/competitions": {
      "get": {
        "tags": [
          "competitions"
        ],
        "operationId": "getMyCompetitions",
        "responses": {
          "200": {
            "description": "Competitions you have entered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MyCompetition"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/orgs": {
      "get": {
        "tags": [
          "orgs"
        ],
        "operationId": "listOrgs",
        "responses": {
          "200": {
            "description": "Organizations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrgSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/orgs/{slug}": {
      "get": {
        "tags": [
          "orgs"
        ],
        "operationId": "getOrg",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The org and its competitions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgDetail"
                }
              }
            }
          },
          "404": {
            "description": "No such organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/orgs/{slug}/admin/competitions": {
      "post": {
        "tags": [
          "competitions"
        ],
        "operationId": "createCompetition",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCompetitionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Competition created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCompetitionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in as an admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/orgs/{slug}/admin/invites": {
      "post": {
        "tags": [
          "invites"
        ],
        "operationId": "createInvites",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvitesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Codes generated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateInvitesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in as an admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/orgs/{slug}/admin/overview": {
      "get": {
        "tags": [
          "overview"
        ],
        "operationId": "getAdminOverview",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Org-wide admin view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOverview"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in as an admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/orgs/{slug}/competitions/{cid}": {
      "get": {
        "tags": [
          "competitions"
        ],
        "operationId": "getCompetitionLeaderboard",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Standings for this competition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Leaderboard"
                }
              }
            }
          },
          "404": {
            "description": "No such organization or competition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/orgs/{slug}/competitions/{cid}/aggregate": {
      "get": {
        "tags": [
          "aggregate"
        ],
        "operationId": "getCompetitionAggregate",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Totals across this competition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Aggregate"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in as an admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No such organization or competition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/orgs/{slug}/competitions/{cid}/members/{id}": {
      "get": {
        "tags": [
          "members"
        ],
        "operationId": "getMemberDetail",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The member's standing and posts by week",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberDetail"
                }
              }
            }
          },
          "404": {
            "description": "No such organization or member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sync": {
      "post": {
        "tags": [
          "sync"
        ],
        "operationId": "pushSync",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Snapshot batch ingested",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing sync token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminOverview": {
        "type": "object",
        "required": [
          "org",
          "adminName",
          "competitions",
          "standings",
          "invites",
          "aggregate",
          "defaults"
        ],
        "properties": {
          "adminName": {
            "type": "string"
          },
          "aggregate": {
            "$ref": "#/components/schemas/Aggregate"
          },
          "competitions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompetitionInfo"
            }
          },
          "current": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CompetitionInfo"
              }
            ]
          },
          "defaults": {
            "$ref": "#/components/schemas/ScoringConfig",
            "description": "Sensible defaults for the \"new competition\" form."
          },
          "invites": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InviteRow"
            }
          },
          "org": {
            "$ref": "#/components/schemas/OrgSummary"
          },
          "standings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StandingRow"
            }
          }
        }
      },
      "Aggregate": {
        "type": "object",
        "description": "Org-wide totals — the aggregate view, which the ranked list alone doesn't give you.",
        "required": [
          "participants",
          "scoringParticipants",
          "totalPosts",
          "gradedPosts",
          "totalImpressions",
          "totalReactions",
          "totalComments",
          "totalReposts",
          "totalFollowers",
          "totalPoints",
          "invitesOpen",
          "invitesRedeemed"
        ],
        "properties": {
          "gradedPosts": {
            "type": "integer",
            "minimum": 0
          },
          "invitesOpen": {
            "type": "integer",
            "minimum": 0
          },
          "invitesRedeemed": {
            "type": "integer",
            "minimum": 0
          },
          "participants": {
            "type": "integer",
            "minimum": 0
          },
          "scoringParticipants": {
            "type": "integer",
            "minimum": 0
          },
          "totalComments": {
            "type": "integer",
            "format": "int64"
          },
          "totalFollowers": {
            "type": "integer",
            "format": "int64"
          },
          "totalImpressions": {
            "type": "integer",
            "format": "int64"
          },
          "totalPoints": {
            "type": "number",
            "format": "double"
          },
          "totalPosts": {
            "type": "integer",
            "minimum": 0
          },
          "totalReactions": {
            "type": "integer",
            "format": "int64"
          },
          "totalReposts": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "description": "A JSON error body. Every API route returns this shape on failure, so the generated client\nand the extension can rely on `{ \"error\": \"...\" }` regardless of status.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "CommentPayload": {
        "type": "object",
        "required": [
          "urn",
          "commenterUrn"
        ],
        "properties": {
          "commenterName": {
            "type": [
              "string",
              "null"
            ]
          },
          "commenterUrn": {
            "type": "string"
          },
          "createdAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "urn": {
            "type": "string"
          }
        }
      },
      "CompetitionInfo": {
        "type": "object",
        "required": [
          "id",
          "name",
          "startAt",
          "endAt",
          "isActive",
          "config"
        ],
        "properties": {
          "config": {
            "$ref": "#/components/schemas/ScoringConfig",
            "description": "The scoring rules in force — this is what the \"how the challenge is configured\" screen reads."
          },
          "endAt": {
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "isActive": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "startAt": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CreateCompetitionRequest": {
        "type": "object",
        "required": [
          "name",
          "start",
          "end",
          "config"
        ],
        "properties": {
          "config": {
            "$ref": "#/components/schemas/ScoringConfig"
          },
          "end": {
            "type": "string",
            "description": "`YYYY-MM-DD`, inclusive through end of day."
          },
          "name": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "description": "`YYYY-MM-DD`."
          }
        }
      },
      "CreateCompetitionResponse": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CreateInvitesRequest": {
        "type": "object",
        "properties": {
          "count": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "description": "`\"participant\"` (default) or `\"admin\"`."
          }
        }
      },
      "CreateInvitesResponse": {
        "type": "object",
        "required": [
          "codes"
        ],
        "properties": {
          "codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "InviteRow": {
        "type": "object",
        "required": [
          "code",
          "role",
          "redeemed",
          "createdAt"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "redeemed": {
            "type": "boolean"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "JoinRequest": {
        "type": "object",
        "required": [
          "inviteCode",
          "name",
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "inviteCode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "JoinResponse": {
        "type": "object",
        "required": [
          "ok",
          "orgSlug",
          "orgName",
          "memberId",
          "syncToken",
          "isAdmin"
        ],
        "properties": {
          "isAdmin": {
            "type": "boolean"
          },
          "memberId": {
            "type": "integer",
            "format": "int64"
          },
          "ok": {
            "type": "boolean"
          },
          "orgName": {
            "type": "string"
          },
          "orgSlug": {
            "type": "string"
          },
          "syncToken": {
            "type": "string",
            "description": "Shown once, on the confirmation screen — paste it into the extension to start syncing."
          }
        }
      },
      "Leaderboard": {
        "type": "object",
        "description": "The public leaderboard payload: standings, the competition, and the rules behind the numbers.",
        "required": [
          "org",
          "standings"
        ],
        "properties": {
          "aggregate": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Aggregate",
                "description": "Always None here — see `aggregate_for`, which an admin-only endpoint serves separately so\nthe board itself stays the same for every reader."
              }
            ]
          },
          "competition": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CompetitionInfo"
              }
            ]
          },
          "org": {
            "$ref": "#/components/schemas/OrgSummary"
          },
          "standings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StandingRow"
            }
          }
        }
      },
      "LinkRequest": {
        "type": "object",
        "required": [
