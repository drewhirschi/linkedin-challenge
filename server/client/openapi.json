            "type": [
              "string",
              "null"
            ]
          },
          "isAdmin": {
            "type": "boolean",
            "description": "Whether this member administers their org — the dashboard is the only thing it unlocks."
          },
          "memberId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "orgSlug": {
            "type": [
              "string",
              "null"
            ]
          },
          "signedIn": {
            "type": "boolean"
          }
        }
      },
      "MemberDetail": {
        "type": "object",
        "required": [
          "org",
          "memberId",
          "displayName",
          "weeks",
          "outsideWindow"
        ],
        "properties": {
          "competition": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CompetitionInfo"
              }
            ]
          },
          "displayName": {
            "type": "string"
          },
          "memberId": {
            "type": "integer",
            "format": "int64"
          },
          "org": {
            "$ref": "#/components/schemas/OrgSummary"
          },
          "outsideWindow": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostStat"
            },
            "description": "Posts we hold that fall outside the competition window."
          },
          "profileUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "standing": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/StandingRow",
                "description": "This member's row in the standings, when they have collected data."
              }
            ]
          },
          "weeks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WeekGroup"
            }
          }
        }
      },
      "MemberInfo": {
        "type": "object",
        "required": [
          "memberUrn"
        ],
        "properties": {
          "firstName": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastName": {
            "type": [
              "string",
              "null"
            ]
          },
          "memberUrn": {
            "type": "string"
          },
          "profileUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "publicIdentifier": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Metrics": {
        "type": "object",
        "properties": {
          "comments": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "followersFromPost": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "impressions": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "impressionsInNetwork": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "impressionsOutOfNetwork": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "profileViewersFromPost": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "reactions": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "reposts": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "saves": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "sends": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "MyCompetition": {
        "type": "object",
        "description": "One competition a member has entered, plus where they stand in it — the home page's row.",
        "required": [
          "org",
          "competition",
          "entrants"
        ],
        "properties": {
          "competition": {
            "$ref": "#/components/schemas/CompetitionInfo"
          },
          "entrants": {
            "type": "integer",
            "minimum": 0
          },
          "org": {
            "$ref": "#/components/schemas/OrgSummary"
          },
          "standing": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/StandingRow",
                "description": "Absent until the member has collected data inside the window."
              }
            ]
          }
        }
      },
      "OrgDetail": {
        "type": "object",
        "description": "An org and the competitions it runs.",
        "required": [
          "org",
          "competitions",
          "entrantCounts"
        ],
        "properties": {
          "competitions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompetitionInfo"
            }
          },
          "entrantCounts": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Entrant count per competition, index-aligned with `competitions`."
          },
          "org": {
            "$ref": "#/components/schemas/OrgSummary"
          }
        }
      },
      "OrgSummary": {
        "type": "object",
        "required": [
          "slug",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "PostPayload": {
        "type": "object",
        "required": [
          "urn",
          "permalink",
          "metrics"
        ],
        "properties": {
          "comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommentPayload"
            },
            "description": "Comments the extension could read, with their authors. Absent or empty simply means we\ndidn't read any this time — it is not a claim that the post has none."
          },
          "createdAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "metrics": {
            "$ref": "#/components/schemas/Metrics"
          },
          "permalink": {
            "type": "string"
          },
          "textPreview": {
            "type": [
              "string",
              "null"
            ]
          },
          "urn": {
            "type": "string"
          }
        }
      },
      "PostStat": {
        "type": "object",
        "required": [
          "id",
          "urn",
          "permalink",
          "postedAt",
          "impressions",
          "reactions",
          "comments",
          "commentsByOthers",
          "reposts",
          "sends",
          "saves",
          "impressionsInNetwork",
          "impressionsOutOfNetwork",
          "profileViewersFromPost",
          "followersFromPost",
          "inWindow"
        ],
        "properties": {
          "comments": {
            "type": "integer",
            "format": "int64",
            "description": "LinkedIn's total comment count."
          },
          "commentsByOthers": {
            "type": "integer",
            "format": "int64",
            "description": "Comments by people other than the author — what actually scores. Equals `comments` until\nwe have read the comment list for this post."
          },
          "followersFromPost": {
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "impressions": {
            "type": "integer",
            "format": "int64"
          },
          "impressionsInNetwork": {
            "type": "integer",
            "format": "int64"
          },
          "impressionsOutOfNetwork": {
            "type": "integer",
            "format": "int64"
          },
          "inWindow": {
            "type": "boolean",
            "description": "False when the post falls outside the competition window."
          },
          "permalink": {
            "type": "string"
          },
          "postedAt": {
            "type": "integer",
            "format": "int64",
            "description": "Post creation time, or the first snapshot's time when LinkedIn didn't give us one."
          },
          "profileViewersFromPost": {
            "type": "integer",
            "format": "int64"
          },
          "reactions": {
            "type": "integer",
            "format": "int64"
          },
          "reposts": {
            "type": "integer",
            "format": "int64"
          },
          "saves": {
            "type": "integer",
            "format": "int64"
          },
          "sends": {
            "type": "integer",
            "format": "int64"
          },
          "textPreview": {
            "type": [
              "string",
              "null"
            ]
          },
          "urn": {
            "type": "string"
          }
        }
      },
      "ProfilePayload": {
        "type": "object",
        "properties": {
          "followerCount": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "profileViews": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "ScoringConfig": {
        "type": "object",
        "description": "Per-competition scoring parameters, stored as JSON on the `Competition` row.",
        "required": [
          "maxPostsPerWeek",
          "perReaction",
          "perComment",
          "perRepost",
          "perSend",
          "perSave",
          "perImpression",
          "perFollowerGained",
          "perProfileView",
          "normalizeByFollowers",
          "followerBaseline"
        ],
        "properties": {
          "followerBaseline": {
            "type": "integer",
            "format": "int64",
            "default": 1000
          },
          "maxPostsPerWeek": {
            "type": "integer",
            "format": "int32",
            "description": "Posts beyond this many per week don't score (only the highest-scoring ones count).",
            "default": 3,
            "minimum": 0
          },
          "normalizeByFollowers": {
            "type": "boolean",
            "description": "If true, post points are scaled by `follower_baseline / follower_count`.",
            "default": true
          },
          "perComment": {
            "type": "number",
            "format": "double",
            "default": 3.0
          },
          "perFollowerGained": {
            "type": "number",
            "format": "double",
            "default": 10.0
          },
          "perImpression": {
            "type": "number",
            "format": "double",
            "default": 0.01
          },
          "perProfileView": {
            "type": "number",
            "format": "double",
            "default": 0.5
          },
          "perReaction": {
            "type": "number",
            "format": "double",
            "default": 1.0
          },
          "perRepost": {
            "type": "number",
            "format": "double",
            "default": 5.0
          },
          "perSave": {
            "type": "number",
            "format": "double",
            "default": 3.0
          },
          "perSend": {
            "type": "number",
            "format": "double",
            "description": "A \"send\" is a private share — high intent, so usually worth more than a public repost.",
            "default": 5.0
          }
        }
      },
      "SessionDeviceRequest": {
        "type": "object",
        "required": [
          "sessionToken"
        ],
        "properties": {
          "sessionToken": {
            "type": "string",
            "description": "Value of the `session` cookie for this server."
          }
        }
      },
      "SessionDeviceResponse": {
        "type": "object",
        "required": [
          "syncToken",
          "displayName",
          "orgName",
          "orgSlug",
          "memberId",
          "linked"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          },
          "linked": {
            "type": "boolean",
            "description": "True once a LinkedIn identity is bound; false means this is a first link."
          },
          "memberId": {
            "type": "integer",
            "format": "int64"
          },
          "orgName": {
            "type": "string"
          },
          "orgSlug": {
            "type": "string"
          },
          "syncToken": {
            "type": "string"
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "required": [
          "ok",
          "displayName",
          "orgSlug"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "orgSlug": {
            "type": "string"
          }
        }
      },
      "SignupRequest": {
        "type": "object",
        "required": [
          "orgName",
          "name",
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "orgName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "SignupResponse": {
        "type": "object",
        "required": [
          "ok",
          "orgSlug"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "orgSlug": {
            "type": "string"
          }
        }
      },
      "StandingRow": {
        "type": "object",
        "required": [
          "rank",
          "memberId",
          "displayName",
          "followerCount",
          "postPoints",
          "profilePoints",
          "total",
          "gradedPosts",
          "totalPosts"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          },
          "followerCount": {
            "type": "integer",
            "format": "int64"
          },
          "gradedPosts": {
            "type": "integer",
            "minimum": 0
          },
          "memberId": {
            "type": "integer",
            "format": "int64"
          },
          "postPoints": {
            "type": "number",
            "format": "double"
          },
          "profilePoints": {
            "type": "number",
            "format": "double"
          },
          "profileUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "rank": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "number",
            "format": "double"
          },
          "totalPosts": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "SyncRequest": {
        "type": "object",
        "required": [
          "profile",
          "posts"
        ],
        "properties": {
          "capturedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "posts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostPayload"
            }
          },
          "profile": {
            "$ref": "#/components/schemas/ProfilePayload"
          }
        }
      },
      "SyncResponse": {
        "type": "object",
        "required": [
          "ok",
          "postsIngested",
          "nextSyncAfterSeconds"
        ],
        "properties": {
          "nextSyncAfterSeconds": {
            "type": "integer",
            "format": "int64"
          },
          "ok": {
            "type": "boolean"
          },
          "postsIngested": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "WeekGroup": {
        "type": "object",
        "description": "Posts bucketed by the same weekly buckets the scoring uses, so the grouping matches how\npoints were actually earned.",
        "required": [
          "week",
          "startAt",
          "endAt",
          "posts"
        ],
        "properties": {
          "endAt": {
            "type": "integer",
            "format": "int64"
          },
          "posts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostStat"
            }
          },
          "startAt": {
            "type": "integer",
            "format": "int64"
          },
          "week": {
            "type": "integer",
            "format": "int64",
            "description": "0-based week index from the competition start."
          }
        }
      }
    }
  }
}